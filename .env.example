# Local development works after npm run db:setup. Vercel REQUIRES a persistent database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Canonical HTTPS origin for checkout redirects and email links
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable Stripe Tax after configuring tax registrations in Stripe.
STRIPE_AUTOMATIC_TAX=false
# Optional transactional mail adapter; no automatic emails without configuration.
RESEND_API_KEY=
MAIL_FROM=
# Operator CLI only. Never NEXT_PUBLIC_ and never commit populated values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
